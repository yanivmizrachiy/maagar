# Enforce LF line endings for all text files checked out on any OS.
# This prevents CRLF issues when running shell scripts on Windows+WSL/Git Bash.

* text=auto eol=lf

# Explicit LF for executable scripts
*.sh   text eol=lf
*.py   text eol=lf

# Explicit LF for web and data files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binary files — no line-ending conversion
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
